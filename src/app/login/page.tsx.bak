"use client";

import React, {
  useState,
  useEffect,
  useCallback,
  useRef,
  FormEvent,
} from "react";
import {
  signInWithEmailAndPassword,
  onAuthStateChanged,
  User,
} from "firebase/auth";
import { FirebaseError } from "firebase/app";
import { auth } from "@/lib/firebase";
import { useRouter } from "next/navigation";

export const dynamic = "force-dynamic";

function isFirebaseError(error: unknown): error is FirebaseError {
  return (
    typeof error === "object" &&
    error !== null &&
    "code" in (error as Record<string, unknown>) &&
    typeof (error as Record<string, unknown>).code === "string"
  );
}

export default function LoginPage() {
  const [email, setEmail] = useState<string>("");
  const [password, setPassword] = useState<string>("");
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState<boolean>(false);
  const [authInitializing, setAuthInitializing] = useState<boolean>(true);
  const router = useRouter();

  // Prevent state updates after component unmount
  const isMounted = useRef<boolean>(true);
  useEffect(() => {
    return () => {
      isMounted.current = false;
    };
  }, []);

  // Redirect if user is already authenticated
  useEffect(() => {
    const unsubscribe = onAuthStateChanged(auth, (user: User | null) => {
      if (user && isMounted.current) {
        router.replace("/");
      }
      if (isMounted.current) {
        setAuthInitializing(false);
      }
    });
    return () => {
      unsubscribe();
    };
  }, [router]);

  const handleLogin = useCallback(
    async (e: FormEvent) => {
      e.preventDefault();
      if (loading) return;
      setLoading(true);
      setError(null);

      const trimmedEmail = email.trim();
      const trimmedPassword = password;

      if (!trimmedEmail || !trimmedPassword) {
        setError("Molimo unesite email i lozinku.");
        setLoading(false);
        return;
      }

      try {
        console.log("🔐 Pokrećem autentifikaciju za:", trimmedEmail);
        const userCredential = await signInWithEmailAndPassword(
          auth,
          trimmedEmail,
          trimmedPassword
        );
        console.log("✅ Uspješna prijava:", userCredential.user.uid);
        if (isMounted.current) {
          router.replace("/");
        }
      } catch (err) {
        console.error("❌ Greška pri prijavi:", err);
        let message = "Greška pri prijavi. Provjerite podatke.";
        if (isFirebaseError(err)) {
          // Map common Firebase auth error codes to user‑friendly messages
          switch (err.code) {
            case "auth/invalid-email":
              message = "Neispravan format email adrese.";
              break;
            case "auth/user-disabled":
              message = "Korisnički račun je onemogućen.";
              break;
            case "auth/user-not-found":
            case "auth/wrong-password":
              message = "Pogrešan email ili lozinka.";
              break;
            case "auth/too-many-requests":
              message = "Previše pokušaja prijave. Pokušajte kasnije.";
              break;
            default:
              message = err.message || message;
          }
        }
        if (isMounted.current) {
          setError(message);
        }
      } finally {
        if (isMounted.current) {
          setLoading(false);
        }
      }
    },
    [email, password, loading, router]
  );

  return (
    <div
      suppressHydrationWarning={true}
      className="flex min-h-screen items-center justify-center bg-[#0D0D0D] text-white p-4"
    >
      <div className="w-full max-w-md p-8 bg-[#141414] border border-[#2FE93D]/30 rounded-2xl shadow-xl relative">
        <h2 className="text-3xl font-bold text-center text-[#2FE93D] mb-6">
          MirbInvestments Login
        </h2>

        {error && (
          <div
            role="alert"
            className="mb-4 p-3 bg-red-900/50 border border-red-500 rounded text-red-200 text-sm"
          >
            {error}
          </div>
        )}

        {authInitializing ? (
          <div className="flex items-center justify-center h-48">
            <svg
              className="animate-spin h-12 w-12 text-[#2FE93D]"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
              />
            </svg>
          </div>
        ) : (
          <form onSubmit={handleLogin} className="space-y-4" noValidate>
            <div>
              <label
                htmlFor="email"
                className="block text-xs uppercase tracking-wider text-gray-400 mb-1"
              >
                Email
              </label>
              <input
                id="email"
                type="email"
                required
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                className="w-full px-4 py-3 bg-[#0D0D0D] border border-gray-800 rounded-lg focus:border-[#2FE93D] outline-none text-white transition-all"
                placeholder="admin@mirbinvestments.crypto"
                autoComplete="email"
              />
            </div>

            <div>
              <label
                htmlFor="password"
                className="block text-xs uppercase tracking-wider text-gray-400 mb-1"
              >
                Lozinka
              </label>
              <input
                id="password"
                type="password"
                required
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                className="w-full px-4 py-3 bg-[#0D0D0D] border border-gray-800 rounded-lg focus:border-[#2FE93D] outline-none text-white transition-all"
                placeholder="••••••••"
                autoComplete="current-password"
              />
            </div>

            <button
              type="submit"
              disabled={loading}
              className="w-full py-3 bg-[#2FE93D] text-black font-bold rounded-lg hover:bg-[#25c432] transition-all shadow-lg shadow-[#2FE93D]/20 disabled:opacity-50"
            >
              {loading ? "Prijavljivanje..." : "Prijavi se"}
            </button>
          </form>
        )}
      </div>
    </div>
  );
}